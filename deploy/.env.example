# Production settings for deploy/compose.prod.yml. On the server, deploy/make-env.sh writes deploy/.env
# with fresh random passwords; add the rest by hand there. Never commit deploy/.env.
MYSQL_DATABASE=altheo
MYSQL_USER=altheo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SECRET_KEY=

# The API's public name. Caddy gets an HTTPS certificate for it. Until there's a domain, the server's IP as
# an sslip.io name (which points back at that IP).
API_HOST=89-168-66-187.sslip.io

# Filled in once the website has its address (#32).
CORS_ORIGINS=
FRONTEND_URL=
SESSION_COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Payments and texts stay off until these are set (the root .env.example says what each one is).
MOOLRE_USERNAME=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_VAS_KEY=
MOOLRE_SMS_SENDER_ID=
PAYSTACK_SECRET_KEY=
