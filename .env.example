# Copy to .env (`make setup` does this). Used by docker compose.
MYSQL_DATABASE=altheo
MYSQL_USER=altheo
MYSQL_PASSWORD=altheo-dev-password
MYSQL_ROOT_PASSWORD=altheo-dev-root-password
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Signs short-lived values (Google sign-in state). Any long random string locally; a secret one in production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Google sign-in (optional locally). Create a Web OAuth client in Google Cloud with redirect URI
#   http://localhost:5173/api/auth/google/callback
# then paste the values here. Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Moolre for Mobile Money, used first when the username, public key and account number are all set.
# Use MOOLRE_BASE_URL=https://sandbox.moolre.com to test. The callback secret checks Moolre's notifications.
MOOLRE_USERNAME=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_CALLBACK_SECRET=

# Texts to tenants (#27) go through Moolre SMS when both are set: the SMS "VAS key" (not the payments key)
# and a sender name approved at app.moolre.com (max 11 letters/digits, e.g. ALTHEO). Empty: texts are only
# logged in local development, and off in production.
MOOLRE_SMS_VAS_KEY=
MOOLRE_SMS_SENDER_ID=

# Paystack secret key, the backup when Moolre isn't set up. Use a TEST key locally (sk_test_…, from the Paystack dashboard).
# Leave both empty to use the pretend payment mode, which only works in local development.
PAYSTACK_SECRET_KEY=
