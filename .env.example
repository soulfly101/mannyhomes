# Copy to .env (`make setup` does this). Used by docker compose.
MYSQL_DATABASE=altheo
MYSQL_USER=altheo
MYSQL_PASSWORD=altheo-dev-password
MYSQL_ROOT_PASSWORD=altheo-dev-root-password
MYSQL_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Signs short-lived values (Google sign-in state). Any long random string locally; a secret one in production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Google sign-in (optional locally). Create a Web OAuth client in Google Cloud with redirect URI
#   http://localhost:5173/api/auth/google/callback
# then paste the values here. Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
