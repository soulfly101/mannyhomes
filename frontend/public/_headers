# Cloudflare Pages response headers (#32). Vite gives built files content hashes, so they can be cached
# for a year; everything else (index.html) is checked again on each visit, so a deploy shows at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
